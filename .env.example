# database reads the imported Supabase TourAPI catalog. tourapi is direct live search; example is demo-only.
TRAVEL_SEARCH_DATA_SOURCE=database

# Server-side TourAPI settings. Use the KorService2 base URL, without an operation name.
# Paste the general (decoded) key from data.go.kr into TOUR_API_SERVICE_KEY.
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_APP=AITravelPlanner

# Codyssey academy AI proxy. Paste only your OpenAI-compatible virtual key here.
# The app defaults to https://copa.codyssey.kr and gpt-5-mini.
CODYSSEY_OPENAI_KEY=
# Optional overrides: CODYSSEY_BASE_URL=https://copa.codyssey.kr
# CODYSSEY_MODEL=gpt-5-mini

# Search history storage: supabase (default) or disabled; legacy JSON is import-only
TRAVEL_SEARCH_HISTORY_STORE=supabase
# Production: set a stable random secret (at least 32 bytes) in the server environment/secret manager.
# Local development may leave this blank; a private persistent key file is created under server/data.
TRAVEL_BROWSER_COOKIE_SECRET=
# Optional frontend origin when frontend and API are hosted on different origins
WEB_ORIGIN=http://localhost:5173

# Supabase browser client (use a publishable key, never a service_role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional Kakao Maps JavaScript key; register the local site origin in Kakao Developers
VITE_KAKAO_MAP_JAVASCRIPT_KEY=

# Server only: search history and administrative place imports.
# Never prefix this key with VITE_. Never commit real keys.
SUPABASE_SECRET_KEY=
# Optional server overrides; defaults to the corresponding VITE_SUPABASE_* values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
